{
  "name": "pariscore",
  "version": "0.3.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && node scripts/postbuild.mjs",
    "start": "RUN_BUN_TIMEOUT_MS=0 NODE_ENV=production node scripts/run-bun.js .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint src scripts public packages",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-bun.js test",
    "qa:node": "node scripts/qa-node-check.js",
    "qa:press-review": "bun run scripts/qa-press-review.ts",
    "ecc:scan": "npx -y ecc-agentshield@1.4.0 scan",
    "deploy:force-rebuild": "echo 'force rebuild'",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "scrape:elo": "bun run scripts/scrape-tennis-elo.ts",
    "scrape:elo:dry": "bun run scripts/scrape-tennis-elo.ts --dry-run",
    "scrape:dr": "bun run scripts/scrape-tennis-dr.ts",
    "scrape:dr:dry": "bun run scripts/scrape-tennis-dr.ts --dry-run",
    "scrape:dr:force": "LEGAL_OVERRIDE_CONFIRMED=1 bun run scripts/scrape-tennis-dr.ts",
    "mobile:assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mobile-build.ps1 -Step assets",
    "mobile:sync": "cap sync android",
    "mobile:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mobile-build.ps1 -Step debug",
    "mobile:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mobile-build.ps1 -Step release",
    "mobile:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mobile-build.ps1 -Step verify",
    "mobile:qa": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mobile-qa.ps1",
    "mobile:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mobile-build.ps1 -Step all",
    "pm:init": "node scripts/pm-loop.js init",
    "pm:gantt": "node scripts/pm-loop.js gantt",
    "pm:status": "node scripts/pm-loop.js status",
    "pm:complete": "node scripts/pm-loop.js complete",
    "pm:graphify": "node scripts/pm-loop.js graphify",
    "scrape:on": "python scripts/scrape-ondemand.py",
    "postinstall": "node -e \"try{require('child_process').execSync('npm rebuild better-sqlite3 sharp',{stdio:'pipe',timeout:120000})}catch(e){process.exit(0)}\""
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.33",
    "@ai-sdk/mistral": "^4.0.35",
    "@ai-sdk/openai-compatible": "^3.0.39",
