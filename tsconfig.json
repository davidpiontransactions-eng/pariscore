{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "types": [
      "bun-types"
    ],
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "~/*": [
        "./src/*"
      ],
      "~/skills/*": [
        "./.opencode/skills/*"
      ],
      "~/mcp/*": [
        "./.mcp/*"
      ],
      "~/components/*": [
        "./src/components/*"
      ],
      "~/lib/*": [
        "./src/lib/*"
      ],
      "~/app/*": [
        "./src/app/*"
      ],
      "@pariscore/shared": [
        "./packages/shared/src"
      ],
      "@pariscore/shared/*": [
        "./packages/shared/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next/dev/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/standalone",
    "DeepSeek-Reasonix",
    "pariscore-design-fix",
    "frontend",
    "mini-services"
  ]
}
