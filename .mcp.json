        "OVH_CONSUMER_KEY": "${OVH_CONSUMER_KEY}",
        "SSH_HOST": "51.75.21.239",
        "SSH_USER": "ubuntu",
        "SSH_PRIVATE_KEY_FILE": "C:/Users/David/.ssh/id_rsa_pariscore"
      }
    },
    "hyperresearch": {
      "command": "hpr",
      "args": [
        "mcp"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    "patchright": {
      "command": "npx",
      "args": [
        "tsx",
        "C:/Users/David/ZCodeProject/pariscore/tools/patchright-enhanced/mcp-server.ts"
      ],
      "env": {
        "BROWSER_EXECUTABLE_PATH": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
