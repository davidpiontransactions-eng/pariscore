{
  "mcpServers": {
    "project_fs": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:/Users/David/ZCodeProject/pariscore"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_FILE_PATH": "C:/Users/David/ZCodeProject/pariscore/.context/memory.jsonl"
      }
    },
    "git": {
      "command": "uvx",
      "args": [
        "mcp-server-git",
