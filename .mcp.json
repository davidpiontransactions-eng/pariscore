      "command": "npx",
      "args": [
        "-y",
        "football-docs"
      ]
    },
    "bzzoiro-sports": {
      "type": "http",
      "url": "https://sports.bzzoiro.com/mcp",
      "headers": {
        "Authorization": "Bearer ${BSD_API_KEY}"
      }
    },
    "playwright": {
      "command": "npx",
