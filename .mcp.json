        "PYTHONIOENCODING": "utf-8",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    "scrapy": {
      "command": "python",
      "args": [
        "C:/Users/David/ZCodeProject/pariscore/scripts/scrapy-mcp-server.py"
