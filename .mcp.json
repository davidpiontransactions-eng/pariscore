{
  "mcpServers": {
    "project_fs": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:/Users/David/ZCodeProject/pariscore"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_FILE_PATH": "C:/Users/David/ZCodeProject/pariscore/.context/memory.jsonl"
      }
    },
    "git": {
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "C:/Users/David/ZCodeProject/pariscore"
      ]
    },
    "agentmemory": {
      "command": "npx",
      "args": [
        "-y",
        "@agentmemory/mcp"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    "bzzoiro-sports": {
      "type": "http",
      "url": "https://sports.bzzoiro.com/mcp",
      "headers": {
        "Authorization": "Bearer ${BSD_API_KEY}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "scrapling": {
      "command": "scrapling",
      "args": [
        "mcp"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    "scrapy": {
      "command": "python",
      "args": [
        "C:/Users/David/ZCodeProject/pariscore/scripts/scrapy-mcp-server.py"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    "crawl4ai": {
      "command": "python",
      "args": [
        "C:/Users/David/ZCodeProject/pariscore/scripts/crawl4ai-mcp-server.py"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    }
  }
}
