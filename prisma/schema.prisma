// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Auth & Users ───────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  bets      UserBet[]
  follows   Follow[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── User Follows (players, teams, leagues, matches) ─────────────────────────

model Follow {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityId      String   // "player:djokovic-novak", "team:football:psg", etc.
  category      String   // "player" | "team" | "league" | "match"
  name          String
  sport         String?
  notifications Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([userId, entityId])
  @@index([userId, category])
}

// ─── Sports Data ─────────────────────────────────────────────────────────────

model League {
  id      String  @id
  name    String
  country String
  logo    String?
  tier    String?
  sport   String  @default("football")
  teams   Team[]
  matches Match[]
}

model Team {
  id          String   @id
  name        String
  shortName   String
  country     String?
  logo        String?
  color       String?
  leagueId    String?
  league      League?  @relation(fields: [leagueId], references: [id])
  homeMatches Match[]  @relation("homeMatches")
  awayMatches Match[]  @relation("awayMatches")
  playerAMatches TennisMatch[] @relation("playerAMatches")
  playerBMatches TennisMatch[] @relation("playerBMatches")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Match {
  id          String   @id
  sport       String   @default("football")
  leagueId    String?
  league      League?  @relation(fields: [leagueId], references: [id])
  homeId      String
  awayId      String
  home        Team     @relation("homeMatches", fields: [homeId], references: [id])
  away        Team     @relation("awayMatches", fields: [awayId], references: [id])
  round       String?
  scheduledAt DateTime
  status      String   @default("scheduled")
  liveMinute     Int?
  liveHomeScore  Int?
  liveAwayScore  Int?
  liveStatus     String?
  prediction     Prediction?
  odds           Odds[]
  bets           UserBet[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Prediction {
  id             String       @id @default(cuid())
  matchId        String       @unique
  match          Match        @relation(fields: [matchId], references: [id])
  modelVersionId String?
  modelVersion   ModelVersion? @relation(fields: [modelVersionId], references: [id])
  homeProb       Float
  drawProb       Float?
  awayProb       Float
  bttsProb       Float?
  over25Prob     Float?
  over15Prob     Float?
  under35Prob    Float?
  model          String       @default("Elo+Poisson")
  edge           Float        @default(0)
  confidence     Int          @default(3)

  createdAt      DateTime     @default(now())
}

model Odds {
  id         String @id @default(cuid())
  matchId    String
  match      Match  @relation(fields: [matchId], references: [id])
  bookmaker  String // "Bet365", "Bwin", "Winamax"
  home       Float
  draw       Float?
  away       Float
  movement   String? // "SHORTENING" | "DRIFTING" | "STABLE"

  createdAt DateTime @default(now())
}

model TennisEloSnapshot {
  id         String   @id @default(cuid())
  playerKey  String // nom normalisé tennisabstract (ex: aryna_sabalenka)
  playerName String
  tour       String // "ATP" | "WTA"
  weekIso    String // "2026-W34" — semaine ISO du snapshot
  eloOverall Float
  eloHard    Float?
  eloClay    Float?
  eloGrass   Float?
  hEloRank   Int?
  cEloRank   Int?
  gEloRank   Int?
  createdAt  DateTime @default(now())

  @@unique([playerKey, weekIso])
  @@index([weekIso])
}

model TennisPlayerMatch {
  id           String   @id @default(cuid())
  playerKey    String // clé normalisée tennisabstract
  playerName   String
  tour         String // "ATP" | "WTA"
  date         DateTime
  weekIso      String // semaine ISO du match
  surface      String // "Hard" | "Clay" | "Grass"
  tournament   String
  round        String?
  opponentKey  String? // clé normalisée de l'adversaire
  opponentName String
  result       String // "W" | "L" | "LIVE"
  score        String?
  createdAt    DateTime @default(now())

  @@unique([playerKey, date, opponentKey, round])
  @@index([playerKey, surface, date])
}

model TennisMatch {
  id          String   @id
  playerAId   String
  playerBId   String
  playerA     Team     @relation("playerAMatches", fields: [playerAId], references: [id])
  playerB     Team     @relation("playerBMatches", fields: [playerBId], references: [id])
  tournament  String
  surface     String?  // "hard", "clay", "grass"
  scheduledAt DateTime
  status      String   @default("scheduled")
  round       String?

  // Elo / Stats
  eloA      Float?
  eloB      Float?
  spsA      Float?
  spsB      Float?
  probA     Float?
  probB     Float?
  eloGap    Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── User Features ───────────────────────────────────────────────────────────

model UserBet {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  matchId   String?
  match     Match?   @relation(fields: [matchId], references: [id])
  market    String   // "1X2", "BTTS", "Over/Under 2.5", etc.
  pick      String
  odds      Float
  stake     Float?
  status    String   @default("pending") // "pending" | "won" | "lost" | "void"
  result    String?  // "W", "L", "V"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Bet Manager (gestion de paris sportifs) ────────────────────────────────

model Bankroll {
  id        String        @id @default(cuid())
  name      String
  currency  String        @default("EUR")
  initial   Float         @default(0)
  note      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  bets      Bet[]
  imports   ImportBatch[]
}

model Bet {
  id          String    @id @default(cuid())
  bankrollId  String
  bankroll    Bankroll  @relation(fields: [bankrollId], references: [id])
  betType     String    @default("single") // single | combo | system | back | lay | dutch
  sport       String    @default("football")
  competition String?
  matchLabel  String? // "PSG vs OM", "Alcaraz - Sinner", ticket 1xbet...
  market      String? // "1X2", "BTTS", "Moneyline", "Over/Under 2.5"...
  pick        String?
  stake       Float
  odds        Float     @default(0) // cote simple ou cote combinée totale
  status      String    @default("pending") // pending | won | lost | void | cashout
  payout      Float?
  profit      Float?
  cashoutAt   DateTime?
  bookmaker   String?
  tipster     String?
  category    String?
  tags        String    @default("") // CSV : "montante,taureau,closing"
  closingOdd  Float? // closing odds pour mesurer la valeur
  placedAt    DateTime  @default(now())
  settledAt   DateTime?
  note        String?
  legs        BetLeg[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([bankrollId, placedAt])
  @@index([status])
  @@index([sport])
}

model BetLeg {
  id         String  @id @default(cuid())
  betId      String
  bet        Bet     @relation(fields: [betId], references: [id])
  matchLabel String
  market     String?
  pick       String?
  odds       Float
  order      Int     @default(0)
}

model Bookmaker {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())
}

model ImportBatch {
  id         String   @id @default(cuid())
  bankrollId String
  bankroll   Bankroll @relation(fields: [bankrollId], references: [id])
  source     String   @default("csv") // csv | ocr | manual
  fileName   String?
  count      Int      @default(0)
  status     String   @default("done")
  createdAt  DateTime @default(now())
}

model GeminiCache {
  id        String   @id // key: "gemini-insight:{sport}:{matchId}:{date}"
  data      String   // JSON serialized
  createdAt DateTime @default(now())
}

model KvStore {
  key   String @id
  value String
}

// ─── Stats ligues OddAlerts ──────────────────────────────────────────────────
// Peuplée par scripts/scrape-oddalerts.js (cron PM2 pariscore-cron-oddalerts).
// Lue en readonly par l'API /api/v1/leagues-stats via better-sqlite3.

model LeagueSeasonStats {
  id           String   @id // "{country}/{slug}", ex: "england/premier-league"
  country      String
  slug         String
  leagueName   String
  logoUrl      String?
  sport        String   @default("football")
  seasonLabel  String?
  seasonsJson  String? // [{label,url,current}]
  gamesPlayed  Int      @default(0)
  statsJson    String   @default("{}") // sections [{id,title,items:[{key,label,value,pct,avg}]}]
  fixturesJson String? // prochains matchs + cotes 1X2 best price
  sourceUrl    String?
  source       String   @default("oddalerts")
  updatedAt    DateTime @updatedAt

  @@unique([country, slug])
  @@map("league_season_stats")
}

// ─── Model Versioning & Metrics ─────────────────────────────────────────────

model ModelVersion {
  id          String   @id @default(cuid())
  name        String   // e.g. "v1.0-poisson-elo"
  modelType   String   // "poisson", "dixon-coles", "catboost", "ensemble", "ml-meta"
  version     Int      // incrementing number
  status      String   @default("staging") // "staging", "production", "archived"
  metricsJson String?  // JSON serialized metrics
  configJson  String?  // JSON serialized model config/hyperparams
  trainedAt   DateTime @default(now())
  promotedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  predictions     Prediction[]
  predictionLogs  PredictionLog[]
  modelMetrics    ModelMetrics[]

  @@unique([modelType, version])
  @@index([modelType, status])
}

model ModelMetrics {
  id             String   @id @default(cuid())
  modelVersionId String
  modelVersion   ModelVersion @relation(fields: [modelVersionId], references: [id])
  market         String   // "1x2", "btts", "over25", "double_chance"
  brierScore     Float
  logLoss        Float?
  rps            Float?
  accuracy       Float?
  sampleSize     Int
  period         String   // "daily", "weekly", "monthly"
  computedAt     DateTime @default(now())

  @@index([modelVersionId, market])
  @@index([market, computedAt])
}

model PredictionLog {
  id             String   @id @default(cuid())
  matchId        String
  modelVersionId String?
  modelVersion   ModelVersion? @relation(fields: [modelVersionId], references: [id])
  homeProb       Float
  drawProb       Float
  awayProb       Float
  bttsProb       Float?
  over25Prob     Float?
  edge           Float?
  confidence     Float?
  actualHome     Int?
  actualAway     Int?
  settled        Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([matchId])
  @@index([settled, createdAt])
  @@index([modelVersionId])
}

// ─── Snooker ─────────────────────────────────────────────────────────────────

model SnookerPlayer {
  id            String   @id // clé slug, ex: "ronnie-osullivan"
  name          String
  nationality   String?
  photoUrl      String?
  ranking       Int?     // classement mondial actuel
  eloRating     Float    @default(1500)
  eloHard       Float?   // Elo surface fast (table rapide)
  winPct        Float?   // % victoires carrière
  centuryRate   Float?   // centuries par match (rolling 20)
  break50Rate   Float?   // breaks 50+ par match (rolling 20)
  deciderWinPct Float?   // % victoires en manche décisive
  avgBreak      Float?   // break moyen (rolling 20)
  safetyPct     Float?   // % réussite défense (si dispo)
  longPotPct    Float?   // % longs pots (si dispo)
  formLast10    String?  // "WWLWWLWWWL" — 10 derniers résultats
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  matchesAsA    SnookerMatch[] @relation("SnookerMatchPlayerA")
  matchesAsB    SnookerMatch[] @relation("SnookerMatchPlayerB")
  eloHistory    SnookerEloHistory[]

  @@index([eloRating(sort: Desc)])
}

model SnookerMatch {
  id            String   @id
  playerAId     String
  playerA       SnookerPlayer @relation("SnookerMatchPlayerA", fields: [playerAId], references: [id])
  playerBId     String
  playerB       SnookerPlayer @relation("SnookerMatchPlayerB", fields: [playerBId], references: [id])
  tournament    String
  round         String?  // "Last 128", "QF", "SF", "F"
  bestOf        Int      @default(9)  // best of 7, 9, 11, etc.
  scoreA        Int      @default(0)
  scoreB        Int      @default(0)
  winnerId      String?
  scheduledAt   DateTime
  status        String   @default("scheduled") // scheduled | live | finished
  source        String   @default("cuetracker") // cuetracker | wst | manual
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  frames        SnookerFrame[]
  predictions   SnookerPrediction[]
  odds          SnookerOdds[]

  @@index([scheduledAt])
  @@index([playerAId, scheduledAt])
  @@index([tournament, scheduledAt])
}

model SnookerFrame {
  id          String   @id @default(cuid())
  matchId     String
  match       SnookerMatch @relation(fields: [matchId], references: [id])
  frameNumber Int
  scoreA      Int
  scoreB      Int
  winnerId    String?  // player qui a gagné la frame
  centuryA    Int      @default(0) // nombre de centuries du joueur A
  centuryB    Int      @default(0)
  highestBreakA Int?   // plus haut break du joueur A
  highestBreakB Int?
  createdAt   DateTime @default(now())

  breaks      SnookerBreak[]

  @@unique([matchId, frameNumber])
}

model SnookerBreak {
  id          String   @id @default(cuid())
  frameId     String
  frame       SnookerFrame @relation(fields: [frameId], references: [id])
  playerId    String
  points      Int      // valeur du break (ex: 137)
  isCentury   Boolean  @default(false)
  visitOrder  Int      // ordre de la visite (1er, 2e, etc.)
  createdAt   DateTime @default(now())

  @@index([frameId])
  @@index([playerId, points(sort: Desc)])
}

model SnookerEloHistory {
  id          String   @id @default(cuid())
  playerId    String
  player      SnookerPlayer @relation(fields: [playerId], references: [id])
  eloBefore   Float
  eloAfter    Float
  matchId     String
  opponentElo Float
  kFactor     Float    @default(32)
  expected    Float    // probabilité attendue avant le match
  actual      Float    // 1 = victoire, 0 = défaite
  date        DateTime
  createdAt   DateTime @default(now())

  @@index([playerId, date])
}

model SnookerPrediction {
  id          String   @id @default(cuid())
  matchId     String
  match       SnookerMatch @relation(fields: [matchId], references: [id])
  probA       Float    // probabilité victoire joueur A
  probB       Float    // probabilité victoire joueur B
  model       String   @default("elo+xgboost")
  eloDiff     Float?   // différence Elo avant le match
  edge        Float?   // avantage potentiel vs cotes marché
  confidence  Int      @default(3) // 1-5
  bet         String?  // "match_winner_a" | "match_winner_b" | "over_X.5_frames" | null
  betOdds     Float?   // cote du bet proposé
  kellyStake  Float?   // mise Kelly optimale
  createdAt   DateTime @default(now())

  @@index([matchId])
  @@index([createdAt(sort: Desc)])
}

model SnookerOdds {
  id          String   @id @default(cuid())
  matchId     String
  match       SnookerMatch @relation(fields: [matchId], references: [id])
  bookmaker   String   // "1xbet", "bet365", etc.
  market      String   // "match_winner" | "frame_handicap" | "total_frames" | "century_yes"
  outcome     String   // "A" | "B" | "over" | "under" | "yes" | "no"
  odds        Float
  impliedProb Float    // 1/odds * 100
  scrapedAt   DateTime @default(now())

  @@index([matchId, bookmaker, market])
  @@index([scrapedAt])
}

// ─── BetExplorer: Dropping Odds & Streaks ────────────────────────────────────

model OddsSnapshot {
  id          String   @id @default(cuid())
  matchId     String   // identifiant match externe (ex: "football:psg-om:2026-09-07")
  sport       String   @default("football")
  league      String?
  homeTeam    String
  awayTeam    String
  bookmaker   String   // "Bet365", "Pinnacle", "Bwin", "1xbet"
  market      String   // "1X2" | "OU25" | "AH05" | "BTTS"
  outcome     String   // "H" | "D" | "A" | "O" | "U" | "Yes" | "No"
  odds        Float
  impliedProb Float    // 1/odds * 100
  source      String   // "betexplorer" | "oddsportal" | "football-data"
  scrapedAt   DateTime @default(now())

  @@index([matchId, bookmaker, market, scrapedAt])
  @@index([scrapedAt])
  @@index([matchId, market])
  @@map("odds_snapshots")
}

model OddsMovement {
  id          String   @id @default(cuid())
  matchId     String
  sport       String   @default("football")
  bookmaker   String
  market      String   // "1X2" | "OU25" | "AH05"
  outcome     String   // "H" | "D" | "A" | "O" | "U"
  openingOdds Float
  closingOdds Float
  movement    Float    // opening - closing (positif = raccourcissement)
  dropPct     Float    // movement / opening * 100
  direction   String   // "SHORTENING" | "DRIFTING" | "STABLE"
  computedAt  DateTime @default(now())

  @@unique([matchId, bookmaker, market, outcome])
  @@index([direction, dropPct])
  @@map("odds_movements")
}

model DroppingOdds {
  id          String   @id @default(cuid())
  matchId     String
  sport       String   @default("football")
  league      String?
  homeTeam    String
  awayTeam    String
  market      String   // "1X2" | "OU25"
  outcome     String   // "H" | "D" | "A" | "O" | "U"
  dropPct     Float    // % de bookmakers en baisse
  avgMovement Float    // mouvement moyen
  bestOdds    Float    // meilleure cote actuelle
  bookmakers  Int      // nombre de bookmakers avec drop
  totalBooks  Int      // nombre total de bookmakers
  scheduledAt DateTime?
  scrapedAt   DateTime @default(now())

  @@index([dropPct(sort: Desc)])
  @@index([scrapedAt])
  @@index([matchId])
  @@map("dropping_odds")
}

model TeamStreak {
  id          String   @id @default(cuid())
  teamName    String   // nom de l'équipe
  sport       String   @default("football")
  league      String?
  streakType  String   // "WIN" | "LOSS" | "BTTS" | "OVER25" | "UNDER25" | "CLEAN_SHEET" | "SCORED" | "CONCEDED" | "UNBEATEN"
  count       Int      // longueur actuelle de la série
  startDate   DateTime // début de la série
  endDate     DateTime // fin de la série (ou now si active)
  isActive    Boolean  @default(true)
  venue       String?  // null=overall, "HOME", "AWAY"
  windowSize  Int      @default(10) // sur les N derniers matchs
  computedAt  DateTime @default(now())

  @@unique([teamName, sport, streakType, venue, isActive])
  @@index([teamName, isActive])
  @@index([streakType, count])
  @@map("team_streaks")
}

// ─── Multisport Calendar ─────────────────────────────────────────────────────

model MultisportEvent {
  id          String   @id @default(cuid())
  sport       String   // "football", "tennis", "basketball", etc.
  country     String?
  league      String?
  homeTeam    String
  awayTeam    String
  eventTime   DateTime?
  status      String   @default("scheduled") // scheduled | live | finished
  scoreHome   Int?
  scoreAway   Int?
  oddsHome    Float?
  oddsDraw    Float?
  oddsAway    Float?
  source      String   @default("betexplorer")
  sourceUrl   String?
  scrapedAt       DateTime  @default(now())
  oddsHomeOpen    Float?
  oddsDrawOpen    Float?
  oddsAwayOpen    Float?
  oddsHomeCurr    Float?
  oddsDrawCurr    Float?
  oddsAwayCurr    Float?
  dropPercent     Float?
  h2hSummary      String?
  homeStreak      String?
  awayStreak      String?
  isPopular       Boolean   @default(false)

  @@unique([sport, homeTeam, awayTeam, scrapedAt])
  @@index([sport, eventTime])
  @@index([sport, status])
  @@map("multisport_events")
}

// ─── BeSoccer Scraped Data ─────────────────────────────────────────────────

model Lineup {
  id          String   @id @default(cuid())
  matchId     String
  teamId      String   // "home" | "away" (ou nom d'équipe normalisé)
  player      String
  position    String   // "GK", "DEF", "MID", "FWD" (schéma normalisé)
  isProbable  Boolean  // true = probable, false = officiel
  rating      Float?   // note de forme (ex: 7.2)
  isAbsence   Boolean  @default(false)
  scrapedAt   DateTime @default(now())

  @@index([matchId, teamId, isProbable])
  @@map("lineups")
}

model BeSoccerAnalysis {
  id                String   @id @default(cuid())
  matchId           String   @unique
  homeTeam          String?
  awayTeam          String?
  h2hStats          String?  // JSON : historique H2H (résultats, scores)
  refereeName       String?
  refereeYellowAvg  Float?   // cartons jaunes moyens par match
  refereeRedAvg     Float?   // cartons rouges moyens par match
  stadium           String?
  weather           String?  // condition météo (ex: "Ensoleillé", "Pluie légère")
  predictions       String?  // JSON : probabilités BeSoccer (1X2, over/under)
  lineupsRaw        String?  // JSON brut des compos (backup)
  scrapedAt         DateTime @default(now())

  @@index([matchId])
  @@index([homeTeam, awayTeam])
  @@map("besoccer_analyses")
}