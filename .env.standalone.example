# =============================================================================
# PariScore — .env.standalone.example (SERVER.JS LEGACY / mode standalone)
# -----------------------------------------------------------------------------
# Inventaire EXHAUSTIF des variables lues par server.js (116 variables,
# collectées automatiquement depuis le code source, session P3-C 2026-08-04).
#
# Usage :
#   cp .env.standalone.example .env          # puis remplir les valeurs réelles
#   node server.js                           # démarre le serveur standalone (port 3000)
#
# IMPORTANT :
#   - Les variables commençant par NEXT_PUBLIC_ (template Next.js) ne sont PAS
#     utilisées par server.js — voir .env.example pour le stack Next.js 16.
#   - Ne JAMAIS committer ce fichier avec des valeurs réelles : les secrets
#     (clés API, JWT_SECRET, mots de passe) restent dans .env uniquement.
# =============================================================================

# ── Serveur ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production            # development | production (force cookies secure)
PUBLIC_BASE_URL=https://pariscore.fr
SITE_ORIGIN=https://pariscore.fr
ALLOWED_ORIGIN=https://pariscore.fr
DATABASE_PATH=./pariscore.db   # défaut : <dossier>/pariscore.db

# ── Sécurité / Auth ──────────────────────────────────────────────────────────
# JWT_SECRET : REQUIS, ≥ 32 caractères. Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Cookie session : secure si NODE_ENV=production OU COOKIE_SECURE=1
COOKIE_SECURE=1
# Admin : mot de passe administrateur (aucun fallback hardcodé — si absent,
# l'admin est forcé à changer de mot de passe au premier login : forceChange)
ADMIN_PASSWORD=
# Token de rafraîchissement RG (fallback ADMIN_PASSWORD si absent) — route admin
RG_REFRESH_TOKEN=
# Compte bêta (login public limité)
BETA_TESTER_PASSWORD=
# Routes de debug : désactivées (404) SAUF si =1. NE PAS activer en prod.
DEBUG_ROUTES_ENABLED=0
# Historique : requiert une authentification (5 routes protégées)
HISTORY_AUTH_REQUIRED=1
# Bypass auth pour /matches (⚠️ à ne PAS activer en production)
MATCHES_AUTH_BYPASS=0
# Override légal explicite (compliance) — ne pas activer sans décision DG
LEGAL_OVERRIDE_CONFIRMED=0

# ── Rate limiting ────────────────────────────────────────────────────────────
API_RATE_LIMIT_MAX=120         # requêtes/min/IP (valeur par défaut du code)

# ── CORS / proxy (P3.1) ──────────────────────────────────────────────────────
# X-Forwarded-For n'est TRUSTÉ que si le peer direct est loopback
# (127.0.0.1 / ::1 / ::ffff:127.0.0.1). Derrière nginx : rien à configurer ici.

# ── Bases de données ─────────────────────────────────────────────────────────
# Chemin du fichier SQLite (voir DATABASE_PATH ci-dessus).
# Prisma (Next.js) utilise DATABASE_URL — voir .env.example.

# ── API Football / Odds (sources de données) ─────────────────────────────────
API_FOOTBALL_KEY=              # inerte tant que AF_REMOVED=true (kill-switch)
USE_API_FOOTBALL_ODDS=0
ODDS_API_KEY=                  # the-odds-api.com — free 500 req/mois
ODDSPAPI_V4_KEY=               # oddsapi (v4)
ODDS_REGIONS=eu
FOOTBALL_DATA_API_KEY=         # api.football-data.org
RAPIDAPI_KEY=                  # RapidAPI générique
FREE_FOOTBALL_RAPIDAPI_KEY=    # rapidapi foot gratuit
THESPORTSDB_KEY=               # thesportsdb.com
TSDB_API_KEY=                  # alias TSDB
SPORTMONKS_API_KEY=            # sportmonks
MATCHSTAT_API_KEY=             # matchstat
GNEWS_API_KEY=                 # gnews.io
GAMEFORECAST_API_KEY=          # gameforecast
GAMEFORECAST_API_HOST=
GAMEFORECAST_API_PATH=
PARLAY_API_KEY=                # service parlay
PARLAY_API_HOST=
PARLAY_API_PATH=
TRANSFERMARKT_API_URL=         # transfermarkt (URL directe)
SOFA_SERVICE_BASE=             # sofacore service (base URL microservice)
FLARESOLVERR_URL=              # FlareSolverr (scraping JS) — ex: http://localhost:8191

# ── BSD Sports (tennis) ──────────────────────────────────────────────────────
BSD_API_KEY=                   # sports.bzzoiro.com — $5/mo tennis endpoints
BSD_TOKEN=                     # token BSD (alias)
BSD_TENNIS_ENABLED=false
BSD_LIVE_TOKEN=                # token websocket live BSD
BSD_LIVE_WS_ENABLED=false
BSD_LIVE_WS_HOST=
BSD_LIVE_WS_PATH=
DEBUG_BSD=0                    # logs debug BSD

# ── IA / Modèles ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=                # Google Gemini
GROQ_API_KEY=                  # Groq
OPENROUTER_API_KEY=            # OpenRouter
XAI_API_KEY=                   # xAI (Grok)
AI_AL_FUNCTION_CALLING=0       # fonction calling agent IA

# ── Web Push (VAPID) — serveur seulement ─────────────────────────────────────
# Générer : bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@pariscore.fr

# ── SMTP (emails transactionnels / reset) ────────────────────────────────────
# Format : smtps://user:pass@host:465 (TLS direct) ou smtp://user:pass@host:587 (STARTTLS)
SMTP_URL=
SMTP_FROM=support@pariscore.fr

# ── Stripe (paiements) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_PRO_FOOT=
STRIPE_PRICE_PRO_TENNIS=
STRIPE_PRICE_DUO_MONTHLY=
STRIPE_PRICE_DUO_ANNUAL=
STRIPE_PRICE_MATCHDAY_FOOT=
STRIPE_PRICE_MATCHDAY_TENNIS=
STRIPE_PRICE_MATCHDAY_DUO=
STRIPE_SUCCESS_URL=https://pariscore.fr/?payment=success
STRIPE_CANCEL_URL=https://pariscore.fr/?payment=cancel
STRIPE_PRO_SUCCESS_URL=
STRIPE_PRO_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=https://pariscore.fr/account
STRIPE_MATCHDAY_PRICE_ID=

# ── Affiliation / tracking ───────────────────────────────────────────────────
GA_PID=                        # Google Ads / Analytics ID
GA_POSTBACK_TOKEN=             # token postback
GA_REDIRECT_BASE=https://pariscore.fr/go/
GA_SUBID_TEMPLATE=

# ── Discord (alertes) ────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=           # webhook général
DISCORD_FOOT_WEBHOOK_URL=      # football
DISCORD_FOOT_BETS_WEBHOOK_URL= # paris foot
DISCORD_FOOT_XG_INTENSITY_WEBHOOK_URL=  # xG intensité
DISCORD_MORNING_PICKS_WEBHOOK_URL=      # picks du matin
DISCORD_MORNING_PICKS_COUNT=3
DISCORD_MORNING_PICKS_HOUR=8
DISCORD_MORNING_PICKS_MIN_CONF=0.6
DISCORD_MORNING_PICKS_MIN_ODDS=1.5
DISCORD_MORNING_PICKS_STRATEGIES=
DISCORD_TENNIS_LIVE_WEBHOOK_URL=
DISCORD_TENNIS_MORNING_WEBHOOK_URL=
DISCORD_TENNIS_MORNING_COUNT=
DISCORD_TENNIS_MORNING_HOUR=
DISCORD_TENNIS_BREAK_SET_URL=
DISCORD_TENNIS_DOMINATION_ODDS_URL=

# ── Telegram (alertes) ───────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
TELEGRAM_FORCE_ALERTS=0
TENNIS_TELEGRAM_CHAT_IDS=

# ── Value alerts (cron) ──────────────────────────────────────────────────────
VALUE_ALERT_INTERVAL_MS=60000
VALUE_ALERT_TTL_MS=3600000
ALERT_EDGE_THRESHOLD=0.05
DAILY_TOP_PICKS_COUNT=5
DAILY_TOP_PICKS_EV_MIN=0.1
DAILY_TOP_PICKS_HOUR=9

# ── Live (SSE / temps réel) ──────────────────────────────────────────────────
PBP_SSE_DEBOUNCE_MS=500
PULSE_DEBOUNCE_MS=1000
LIVE_FOOT_POISSON_CD_MS=30000
LIVE_FOOT_POISSON_ODDS_MIN=1.3
LIVE_FOOT_POISSON_PROB_MIN=0.55
LIVE_XG_INT_CD_MS=45000
LIVE_XG_INT_INTENS_MIN=0.4
LIVE_XG_INT_ODDS_MIN=1.3
LIVE_XG_INT_PROB_MIN=0.55
LIVE_XG_INT_XG_MIN=0.35
ESPN_WP_ENABLED=1              # win probability ESPN
FLASHSCORE_LIVE_STATS_TTL_MS=30000
FLASHSCORE_DEBUG=0

# ── Boot / démarrage ─────────────────────────────────────────────────────────
BOOT_STATS_DELAY_MS=5000
BOOT_STATS_TIMEOUT_MS=30000
BOOT_ODDS_TIMEOUT_MS=15000
SKIP_BOOT_FETCHSTATS=0         # 1 = skip la récupération stats au boot

# ── Algos tennis ─────────────────────────────────────────────────────────────
TENNIS_ELO_SOURCE=             # bsd | tennisabstract | elo
TENNIS_HISTORY_MAX=30
TENNIS_DR_DIFF_THRESHOLD=
TENNIS_DR_VAR_THRESHOLD=
DR_SPIKE_THRESHOLD_PCT=
DIVERGENCE_SLOPE_THRESHOLD_PCT=
PS_DEBUG_ELO=0
PS_DEBUG_FORM=0
PS_DEBUG_FUZZY=0
TENNIS_SURF_DEBUG=0
TENNIS_ABSTRACT_ENABLED=1
TENNIS_ABSTRACT_ELO_SCRAPER=1  # scraper tennisabstract (1087 joueurs)
TENNIS_DEV_BYPASS=0

# ── Tennis live ──────────────────────────────────────────────────────────────
TNNS_LIVE_ENABLED=0
TA_SERVE_STATS_SYNC=1

# ── WOM (Watch-Odds-Movement) ────────────────────────────────────────────────
BETWATCH_USER=                 # betwatch.fr (WOM tennis paywall)
BETWATCH_PASS=
BETWATCH_DISABLED=0
SMARKETS_DISABLED=0
WOM_AUTOPUBLISH=0
WOM_AP_AD_URL=
WOM_AP_INTERVAL_MIN=15
WOM_AP_COOLDOWN_H=24
WOM_AP_DAILY_CAP=20
WOM_AP_SPORTS=football,tennis
WOM_AP_PROB_DELTA=0.05
WOM_AP_VOL_MIN=100

# ── CatBoost (prédiction) ────────────────────────────────────────────────────
CATBOOST_ENABLED=1
CATBOOST_PYTHON_BIN=python3
EDA_PYTHON_BIN=python3

# ── Scraping / anti-bot ──────────────────────────────────────────────────────
USE_CURL_IMPERSONATE=1
CURL_IMPERSONATE_BIN=curl-impersonate
DEBUG_TRACE=0
DEBUG_DR=0
DEBUG_CACHE_PURGE=0
DEBUG_STANDINGS=0

# ── RG (Roland Garros) ───────────────────────────────────────────────────────
RG_INLINE_FALLBACK_MAX_DRAW=4
RG_WORKER_TIMEOUT_MS=45000

# ── ETL / historique ─────────────────────────────────────────────────────────
ETL_FBREF_LOAD=0
HISTORY_BACKFILL_DISABLE=0
SACKMANN_SYNC_DISABLED=true    # compliance CC-BY-NC-SA — garder à true

# ── Cache ────────────────────────────────────────────────────────────────────
# (préfixes de TTL — variables partielles CACHE_TTL_* lues dynamiquement)
# Ex: CACHE_TTL_ODDS=60000

# ── Divers / intégrations ────────────────────────────────────────────────────
SPS_INTERNAL_TOKEN=            # token interne SPS (microservices)
BETMINES_ENABLED=1             # betmines
