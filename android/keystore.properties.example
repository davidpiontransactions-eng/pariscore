# Template keystore — copier vers android/keystore.properties (gitignoré)
# et renseigner les vraies valeurs. Chemin avec des SLASHES uniquement.
# Génération du keystore :
#   keytool -genkeypair -v -keystore <chemin>/pariscore-release.keystore ^
#     -alias pariscore -keyalg RSA -keysize 2048 -validity 10000 ^
#     -storepass <PASSWORD> -keypass <PASSWORD> ^
#     -dname "CN=PariScore, OU=Mobile, O=PariScore, L=Paris, ST=IDF, C=FR"
storeFile=D:/Android/keystore/pariscore-release.keystore
storePassword=CHANGE_ME
keyAlias=pariscore
keyPassword=CHANGE_ME
