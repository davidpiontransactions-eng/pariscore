{
  "$schema": "https://opencode.ai/config.json",
  "shell": "cmd",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "provider": {
    "deepseek": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 60000
      }
    }
  },
  "instructions": [
    ".opencode/instructions/communication.md",
    ".opencode/instructions/deepseek-optimisation.md"
  ]
}
